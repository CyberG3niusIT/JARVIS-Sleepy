<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real theming (JarvisTheme). This host style only
         prevents the default Material system theme from flashing before
         Compose attaches. -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_bg_0</item>
        <item name="android:statusBarColor">@color/jarvis_bg_0</item>
        <item name="android:navigationBarColor">@color/jarvis_bg_0</item>
    </style>
</resources>
