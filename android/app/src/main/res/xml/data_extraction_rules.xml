<?xml version="1.0" encoding="utf-8"?>
<!-- android:allowBackup is false; this file exists only for API levels the
     rules still apply to and stays empty until a runtime backup policy is
     a defined product decision. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
