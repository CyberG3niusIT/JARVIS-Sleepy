* text=auto

# Cross-platform source files
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.wav binary
*.mp3 binary

.gitignore text eol=lf
.gitattributes text eol=lf
*.txt text eol=lf
*.service text eol=lf
*.timer text eol=lf
