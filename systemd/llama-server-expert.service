# Template in the repo; the LIVE unit lives in ~/.config/systemd/user/ (and is what runs). Keep both in
# sync by hand: this file mirrors the verified live unit (2026-09). Install/refresh with:
#   cp systemd/llama-server-expert.service ~/.config/systemd/user/ && systemctl --user daemon-reload
# Do NOT enable it for autostart in normal operation: the expert is started on demand by
# core/model_handover.py and stopped again afterwards (resting state: inactive).
#
# Expert LLM: Qwen3.5-35B-A3B, text only (NO --mmproj, no vision/audio).
# Conflicts=llama-server-primary.service: starting this unit makes systemd stop the primary. There is
# deliberately no After= here (the primary carries the one-directional After=expert; both directions
# would be an ordering cycle). Conflicts= is not a VRAM guarantee -- core/model_handover.py verifies
# the primary's unit and port are gone and waits for VRAM release before it starts this unit.
# Context size must match llm.expert.context_size (32768); port must equal llm.expert.endpoint.

[Unit]
Description=JARVIS Expert LLM - Qwen3.5 35B A3B
After=network.target
Conflicts=llama-server-primary.service

[Service]
Type=simple

Environment=HSA_ENABLE_DXG_DETECTION=1
Environment=HSA_OVERRIDE_GFX_VERSION=11.0.0
Environment=ROCM_PATH=/opt/rocm
Environment=LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm-7.2.1/lib/llvm/lib
Environment=PATH=/opt/rocm/bin:/usr/local/bin:/usr/bin:/bin

WorkingDirectory=/home/alex/llama.cpp/build/bin

ExecStartPre=/usr/bin/test -f /home/alex/jarvis-data/models/llm/Qwen3.5-35B-A3B-abliterated-Q3_K_M.gguf

ExecStart=/home/alex/llama.cpp/build/bin/llama-server \
  -m /home/alex/jarvis-data/models/llm/Qwen3.5-35B-A3B-abliterated-Q3_K_M.gguf \
  --host 127.0.0.1 \
  --port 8082 \
  --ctx-size 32768 \
  --n-gpu-layers 999 \
  --batch-size 512 \
  --ubatch-size 128 \
  --parallel 1 \
  --jinja \
  --reasoning-budget 0

# No Restart=: a crashing expert must not fight the handover; the handover reports it.
Restart=no
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-llm-expert

[Install]
WantedBy=default.target
