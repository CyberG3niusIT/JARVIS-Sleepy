# NEEDS HW VERIFY — see systemd/README.md before installing.
#
# Paths below match config.yaml's llm.local.* (checked into this repo at
# the real /home/alex/... paths already, so they're the strongest
# available evidence of Sleepy's real layout) — but config.yaml is read
# by the Python app, not by systemd, so it was never actually load-bearing
# for THIS unit file. Verify the llama-server binary path and model file
# both exist at these exact locations on Sleepy before enabling.
#
# Replaces the old jarvis.service-adjacent unit that had:
#   /home/user/... (wrong user/host layout) and /mnt/models/... (wrong
#   storage location), plus --ctx-size 8192 (config.yaml says 32768).

[Unit]
Description=llama.cpp server for JARVIS (main LLM, Qwen3.5-35B-A3B)
After=network.target

[Service]
Type=simple
User=alex
# Secrets (if this binary ever needs any) go here, never inline below.
EnvironmentFile=-/home/alex/jarvis/.env
Environment=HSA_OVERRIDE_GFX_VERSION=11.0.0
WorkingDirectory=/home/alex/llama.cpp/build/bin

# NEEDS HW VERIFY: confirm this exact binary path
# (realpath /home/alex/llama.cpp/build/bin/llama-server) and that
# --n-gpu-layers 999 / context-size match what the GPU/VRAM on Sleepy
# actually supports for a 35B model at Q3_K_M.
ExecStart=/home/alex/llama.cpp/build/bin/llama-server \
  -m /home/alex/jarvis-data/models/llm/Qwen3.5-35B-A3B-abliterated-Q3_K_M.gguf \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx-size 32768 \
  --n-gpu-layers 999 \
  --batch-size 512 \
  --ubatch-size 128 \
  --parallel 1 \
  --jinja \
  --reasoning-budget 0 \
  --log-disable

# Preflight: don't even attempt to start if the model file is missing —
# fails fast with a clear journalctl message instead of llama-server's
# own less obvious error.
ExecStartPre=/usr/bin/test -f /home/alex/jarvis-data/models/llm/Qwen3.5-35B-A3B-abliterated-Q3_K_M.gguf

Restart=on-failure
RestartSec=10
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server

[Install]
WantedBy=default.target
