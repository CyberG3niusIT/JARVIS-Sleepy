# NEEDS HW VERIFY — see systemd/README.md before installing.
#
# USER unit (install to ~/.config/systemd/user/, manage with
# `systemctl --user`) — corrected in session #7. Session #6 had this as
# a system-level unit (User=alex, WantedBy=default.target under
# /etc/systemd/system), which was an architectural guess made without
# checking whether an established convention already existed. It did:
# start.sh/stop.sh/restart.sh/status.sh/killswitch.sh/jarvis_aliases.sh
# (repo root) all call `systemctl --user ... jarvis.service` and
# `journalctl --user -u jarvis.service`, and core/health_check.py /
# core/tools/developer_tools.py both query it the same way — a real,
# working control plane already built around jarvis.service being a
# user unit, not a guess to second-guess.
#
# This also converges with the Windows-Audio target (see the task's
# VOICE section): a system-level unit starting before any login has no
# path to Windows Audio / WSLg's audio forwarding, which is tied to an
# active logged-in session. A user unit — which runs as that session —
# is the one that can actually reach it. System-level would need extra
# machinery (a login-independent audio bridge) that doesn't exist and
# wasn't asked for; user-level needs none.
#
# llama-server.service and chatterbox.service remain SYSTEM units (see
# their own files) — headless GPU HTTP servers with no session/audio
# dependency of their own, only JARVIS itself needs the session. Note
# core/tools/developer_tools.py's _devtools_service_status() actually
# hedges on llama-server's scope (checks --user, falls back to system) —
# the codebase itself isn't fully certain either, so this split is a
# reasoned best guess for llama-server specifically, not confirmed fact;
# jarvis.service being user-level IS confirmed by the real scripts above.

# CAVEAT (session #7): After=/Wants= below naming llama-server.service/
# chatterbox.service are NOT reliably enforced across the user/system
# manager boundary — `systemctl --user` runs a separate manager instance
# from the system one, and a user unit generally cannot start or order
# against a system unit the way it can another user unit. Left in as
# documentation of intent and because harmless if unenforced, but do
# NOT rely on `systemctl --user start jarvis.service` to also bring up
# the system-level services: enable/start those independently
# (`sudo systemctl enable --now llama-server.service chatterbox.service`)
# — see the repo-root start.sh, updated this session to do exactly that.
[Unit]
Description=JARVIS Voice Assistant (continuous mode)
After=network.target sound.target llama-server.service chatterbox.service
Wants=llama-server.service chatterbox.service

[Service]
Type=simple
# No User= — user units already run as the invoking user. %h expands to
# that user's home directory; EnvironmentFile can use it directly.
EnvironmentFile=-%h/jarvis/.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/jarvis

# NEEDS HW VERIFY: confirm the venv path and that this venv has every
# dependency jarvis_continuous.py imports at module scope (sounddevice/
# PortAudio in particular — see docs/ARCHITECTURE.md's test-environment
# note: that dependency was NOT installable in the sandbox this pass ran
# in, so it must be specifically checked on Sleepy itself, not assumed).
ExecStart=%h/jarvis-venv/bin/python3 %h/jarvis/jarvis_continuous.py

# Preflight: fails fast if the venv or entrypoint don't exist, instead of
# systemd reporting a bare non-zero exit with no obvious cause.
ExecStartPre=/usr/bin/test -x %h/jarvis-venv/bin/python3
ExecStartPre=/usr/bin/test -f %h/jarvis/jarvis_continuous.py

# Before enabling for real, run scripts/preflight_check.py manually once
# (not wired as ExecStartPre — its check semantics/exit codes weren't
# verified against systemd's pass/fail expectations in this pass):
#   cd ~/jarvis && source ~/jarvis-venv/bin/activate
#   python scripts/preflight_check.py

Restart=on-failure
RestartSec=10
# Give the shutdown sequence in jarvis_continuous.py's finally block
# (coordinator.shutdown, watchdog.stop, tts.kill_active + chatterbox
# session close, memory_manager.save/FAISS persist, context_window.flush,
# and every manager's .stop()) enough time to run instead of being
# SIGKILLed mid-flush.
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=default.target
