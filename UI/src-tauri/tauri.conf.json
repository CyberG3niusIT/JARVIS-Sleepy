{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.R.V.I.S Control Hub",
  "version": "0.1.0",
  "identifier": "local.jarvis.controlhub",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "J.A.R.V.I.S Control Hub",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../Main/JARVIS-Runtime.ps1": "runtime/JARVIS-Runtime.ps1"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["German", "English"]
      }
    }
  }
}
